DATABASE_URL="file:./dev.db"
# At least 32 random characters. The server refuses to start without it.
JWT_SECRET="change-me-to-32-or-more-random-characters!!"
PORT=3000
BIND_HOST=0.0.0.0
CANTEEN_TIMEZONE=Asia/Kolkata
# Set to http://<laptop-LAN-IP>:3000 for the phone demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Order codes (OTP): email (default, free) or sms
OTP_CHANNEL=email
# console = print codes in the terminal; smtp = send real email (Gmail by default)
EMAIL_PROVIDER=console
# Gmail: SMTP_USER is the Gmail address, SMTP_PASSWORD a Google *app password* (not your login password)
SMTP_USER=
SMTP_PASSWORD=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465), EMAIL_FROM

# SMS (only with OTP_CHANNEL=sms)
# console = print codes in the terminal; android-gateway = SMS Gateway for Android (local mode)
SMS_PROVIDER=console
SMS_GATEWAY_URL=http://192.168.1.50:8080
SMS_GATEWAY_USER=sms
SMS_GATEWAY_PASSWORD=change-me
# Dev/test only: this code is always accepted. Never set it in production.
OTP_DEV_CODE=1234
# Max codes per hour from one IP (campus Wi-Fi shares one IP, so keep this generous).
OTP_IP_HOURLY_LIMIT=60

# Set to 1 only when running behind a reverse proxy (Render, Railway) that sets X-Forwarded-For.
TRUST_PROXY=0
